---
import { SITE } from "@/data/site"
const currentYear = new Date().getFullYear()
---

<footer
  class="opacity-80 m-4 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
>
  <div
    class="rounded-lg w-full max-w-screen-xl mx-auto py-4 flex flex-col md:flex-row items-center md:justify-between gap-4"
  >
    <span class="text-sm text-center text-pretty md:text-left text-zinc-800/90 dark:text-zinc-200/90">
      &copy; {currentYear}{" "}
      <a href={SITE.linkedin} class="hover:underline" target="_blank" rel="noopener noreferrer">{SITE.fullName}</a>.
      Template by{" "}
      <a href="https://github.com/midudev/porfolio.dev" class="hover:underline" target="_blank" rel="noopener noreferrer">midudev</a>{" "}
      (CC BY-NC 4.0).
    </span>
    <ul class="flex flex-wrap items-center gap-4 text-sm font-medium dark:text-white/90">
      <li>
        <a href={SITE.github} class="hover:underline" target="_blank" rel="noopener noreferrer">GitHub</a>
      </li>
      <li>
        <a href={SITE.linkedin} class="hover:underline" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </li>
      <li>
        <a id="contact" href={`mailto:${SITE.email}`} class="hover:underline">Contact</a>
      </li>
    </ul>
  </div>
</footer>
