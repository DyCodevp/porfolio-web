---
import GitHub from "./icons/GitHub.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import TechIcon from "./TechIcon.astro"
import TechTag from "./TechTag.astro"
import projectsData from "@/data/projects.json"
import type { TechKey } from "@/data/tech"
import type { TechIconSlug } from "@/data/tech-icons"

interface Project {
  title: string
  kind: string
  description: string
  tags: TechKey[]
  link?: string
  github?: string
  image?: string
  cover?: TechIconSlug
}

const PROJECTS = projectsData as Project[]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, cover, title, kind, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(251,191,36,0.2)] lg:border lg:border-gray-800 lg:hover:border-yellow-400/30">
            {image ? (
              <img
                alt={`Screenshot of ${title}`}
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                width="1280"
                height="800"
                src={image}
              />
            ) : (
              <div
                class="relative grid w-full aspect-[16/10] place-items-center overflow-hidden bg-gray-900 bg-[radial-gradient(ellipse_at_top_left,rgba(251,191,36,0.25),transparent_60%),radial-gradient(ellipse_at_bottom_right,rgba(249,115,22,0.18),transparent_55%)]"
                aria-hidden="true"
              >
                <div class="absolute inset-0 opacity-[0.15] bg-[linear-gradient(to_right,#ffffff1a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff1a_1px,transparent_1px)] bg-[size:24px_24px]" />
                {cover && (
                  <TechIcon
                    slug={cover}
                    class="relative size-20 text-yellow-300/90 drop-shadow-[0_0_30px_rgba(251,191,36,0.45)] transition duration-500 md:group-hover:scale-110"
                  />
                )}
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true" />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
          <p class="mb-1 text-xs font-mono uppercase tracking-wider text-yellow-600 dark:text-yellow-300/90">
            {kind}
          </p>
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">{title}</h3>
          <ul class="flex flex-row flex-wrap mt-3 gap-2" aria-label="Technologies">
            {tags.map((tag) => (
              <li>
                <TechTag tech={tag} />
              </li>
            ))}
          </ul>

          <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
          {(github || link) && (
            <footer class="flex items-center mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-5" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <ExternalLink class="size-4" />
                  Live demo
                </LinkButton>
              )}
            </footer>
          )}
        </div>
      </article>
    ))
  }
</div>
