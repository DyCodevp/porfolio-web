---
import "@fontsource-variable/onest"
import "@/styles/global.css"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import { ClientRouter } from "astro:transitions"
import { SITE } from "@/data/site"

interface Props {
  title: string
  description: string
  image?: string
  canonical?: string
}

const siteUrl = Astro.site ?? new URL(Astro.url.origin)

const {
  description,
  title,
  image = SITE.ogImage,
  canonical = new URL(Astro.url.pathname, siteUrl).href,
} = Astro.props

const ogImage = new URL(image, siteUrl).toString()

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.fullName,
  url: siteUrl.href,
  email: `mailto:${SITE.email}`,
  image: new URL(SITE.avatar, siteUrl).toString(),
  sameAs: [SITE.linkedin, SITE.github],
  jobTitle: SITE.role,
  worksFor: {
    "@type": "Organization",
    name: SITE.company,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "San José",
    addressCountry: "CR",
  },
  knowsAbout: [
    "API integration",
    "REST",
    "SOAP",
    "Microservices",
    "OAuth",
    "JWT",
    "Model Context Protocol",
    "Python",
    "TypeScript",
    "Go",
    "Docker",
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.fullName} />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply the saved theme before first paint to avoid a light/dark flash -->
    <script is:inline>
      ;(function () {
        const pref = localStorage.getItem("theme") ?? "system"
        const isDark =
          pref === "dark" ||
          (pref === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.classList.toggle("dark", isDark)
      })()
    </script>

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={`${SITE.name} · Portfolio`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="darkreader-lock" />
    <ClientRouter />
  </head>

  <body class="relative text-black dark:text-white">
    <div
      class="fixed inset-0 z-[-2] bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(251,191,36,0.14),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(251,191,36,0.08),rgba(0,0,0,0))]"
    >
    </div>
    <!-- Grain texture overlay for tactile depth -->
    <div
      class="pointer-events-none fixed inset-0 z-[-1] opacity-[0.035] dark:opacity-[0.05]"
      style="background-image: url('/noise.svg'); background-size: 200px 200px;"
      aria-hidden="true"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: light;
      }

      :root.dark {
        color-scheme: dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      /* ── Design system: staggered entrance animations ─────────────── */
      @keyframes fade-in-up {
        from {
          opacity: 0;
          translate: 0 20px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .anim-fade-in {
        animation: fade-in-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .anim-delay-1 { animation-delay: 120ms; }
      .anim-delay-2 { animation-delay: 260ms; }
      .anim-delay-3 { animation-delay: 400ms; }
      .anim-delay-4 { animation-delay: 540ms; }

      /* Gradient text utility for the hero name */
      .gradient-name {
        background: linear-gradient(135deg, #f59e0b 10%, #f97316 90%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
      }

      /* Scroll-triggered reveal for named sections (below the fold) */
      @supports (animation-timeline: view()) {
        [data-section] {
          animation: fade-in-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-timeline: view();
          animation-range: entry 0% entry 18%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-fade-in,
        [data-section] {
          animation: none !important;
          opacity: 1 !important;
          translate: none !important;
        }
      }
    </style>
  </body>
</html>
